#!/bin/sh
set -eu
repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if ! command -v pnpm >/dev/null 2>&1; then
  printf '%s\n' 'pre-push: pnpm is required but was not found on PATH.' >&2
  exit 1
fi

printf '%s\n' 'pre-push: running tests...'
pnpm test

printf '%s\n' 'pre-push: checking test coverage...'
pnpm run test:coverage

printf '%s\n' 'pre-push: running lint...'
pnpm lint

# Playwright e2e tests require browser binaries. If this is your first push, run:
#   pnpm exec playwright install
if [ ! -d "$HOME/Library/Caches/ms-playwright" ] && [ ! -d "$HOME/.cache/ms-playwright" ]; then
  printf '%s\n' 'pre-push: Playwright browsers not found. Run: pnpm exec playwright install' >&2
  exit 1
fi

printf '%s\n' 'pre-push: all checks passed.'
